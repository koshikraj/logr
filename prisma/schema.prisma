// logr — Postgres (Supabase) schema.
// JSON-shaped fields (socials, theme, link) are stored as serialized strings.
// Phase 3 adds pgvector for the chat RAG index.
//
// Supabase needs two connection strings:
//   DATABASE_URL — pooled (PgBouncer, :6543, ?pgbouncer=true) for the app at runtime
//   DIRECT_URL   — direct (:5432) for `prisma migrate`, which PgBouncer can't run

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String?  @unique // the owning account (null for the legacy single-user profile)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String   @unique // also the public "@handle" — editable in the dashboard
  name      String
  bio       String
  status    String // current "building X" line
  location  String
  about     String? // longer-form prose for the "A little more" section
  avatarUrl String?
  socials   String // JSON: [{ label, href }]
  theme     String // JSON: { palette, fonts, rounded, accentOverride, postStyle, dotStyle, photoHover, dark }
  pinned    String   @default("[]") // JSON: event ids pinned to the public rail (max 7; display order derived newest-first)

  // Seeded-profile lifecycle (PLAN-seeded-profiles.md). `status` above is the
  // display tagline — this is the claim/publish state machine.
  claimStatus     ClaimStatus @default(owned)
  attributedX     String? // X handle for unclaimed seeded profiles (claim matching)
  attributedGh    String? // GitHub username fallback
  claimProofToken String? // one-time tweet-to-claim code (hashed); invalidated on claim

  events       Event[]
  chatMessages ChatMessage[]
  sources      ProfileSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A citation source used to build a seeded profile (admin-curated).
model ProfileSource {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  fetchedAt DateTime?
  notes     String? // why this source was included / conflicts noted

  @@index([profileId])
}

enum ClaimStatus {
  owned // normal user profile
  draft // seeded, imported, not yet public
  published // seeded + live with the unverified banner
  claimed // was seeded, now claimed by verified owner
  takedown // subject requested removal; hidden, record kept
}

enum Provenance {
  userCreated // user typed it
  userImported // user imported (resume, URL, AI-drafted from their own text)
  seeded // admin-generated from external sources
}

// ---------- Auth.js (NextAuth) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  importJobs    ImportJob[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  username          String? // provider-side handle (X @username) — set by connect flow or lazily from the token; drives seeded-profile claim matching
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  dateOn   String // the event date, ISO "YYYY-MM-DD"; display + year are derived
  title    String
  tags     String[] @default([]) // work | milestone | talk | side_quest | writing (multiple)
  body     String
  icon     String? // optional glyph/emoji shown on the timeline dot
  featured Boolean  @default(true) // include in the "highlights" view on the page
  fullDate Boolean  @default(false) // show the exact day on the timeline (else month + year)

  linkLabel String?
  linkHref  String?

  // Provenance (PLAN-seeded-profiles.md): origin is immutable; `verified` is
  // owner-flippable after claim. sourceUrl is required for provenance=seeded —
  // enforced in the service layer, not here.
  sourceUrl  String?
  provenance Provenance @default(userCreated)
  verified   Boolean    @default(false)

  position Int // explicit ordering (reverse-chronological)

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, position])
}

model Media {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind     String  @default("image") // image | video | link
  url      String? // image/video file URL, provider embed URL, or external link; null = placeholder
  poster   String? // thumbnail/poster image (video frame, or og:image for links)
  provider String? // file | youtube | vimeo | loom | site name (for links)
  title    String? // card title (og:title for links)
  position Int

  @@index([eventId, position])
}

// ---------- Magical-onboarding import jobs ----------
// A background "paste your sources" import run. Tied to userId (not profileId)
// because during onboarding the profile doesn't exist until publish.
// Event payloads are JSON-serialized ReviewEvent[] strings, per convention.

enum ImportJobStatus {
  running
  done
  error
}

enum ImportSourceStatus {
  queued
  fetching
  extracting
  done
  error
}

model ImportJob {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ImportJobStatus @default(running)
  mergedEvents String? // JSON ReviewEvent[] — set after the cross-source merge pass
  consumedAt   DateTime? // set once events were inserted (onboarding publish or dashboard banner)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sources      ImportSource[]

  @@index([userId, createdAt])
}

model ImportSource {
  id         String             @id @default(cuid())
  jobId      String
  job        ImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind       String // github | rss | devto | youtube | site | linkedin | twitter | resume | linkedin-pdf
  url        String? // null for uploaded files
  label      String // chip label, e.g. "github.com/rishi"
  status     ImportSourceStatus @default(queued)
  error      String?
  events     String? // JSON ReviewEvent[] extracted from this source
  eventCount Int                @default(0)
  updatedAt  DateTime           @updatedAt

  @@index([jobId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessionId String // groups a visitor's conversation
  role      String // user | assistant
  content   String
  visitor   String? // hashed IP, for light abuse analytics (never raw)
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

// ---------- MCP OAuth 2.1 (issue #58 phase 2) ----------
// logr's /mcp endpoint is an OAuth resource server; these tables back the
// minimal in-house authorization server (auth-code + PKCE only, public
// clients, dynamic client registration). Codes and tokens are stored as
// sha256 hashes — raw secrets never touch the database.

model OAuthClient {
  id           String   @id @default(cuid()) // the client_id
  name         String // human-readable, shown on the consent screen
  redirectUris String // JSON array of registered redirect URIs
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique // sha256 of the authorization code
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  profileId     String // the profile consented to (the user's own at consent time)
  redirectUri   String
  scope         String // space-separated granted scopes
  codeChallenge String // PKCE S256 challenge
  resource      String? // RFC 8707 resource indicator, when the client sent one
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model OAuthToken {
  id               String    @id @default(cuid())
  clientId         String
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  profileId        String
  scope            String
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([profileId])
}
